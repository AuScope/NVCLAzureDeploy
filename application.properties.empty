# minified conf file: https://github.com/AuScope/NVCLDataServices/blob/master/config/application.properties 
tsg.dbtype=sqlserver

tsg.connectionString=
tsg.username=
tsg.password=

sysadmin.email=

webapp.url=

download.url=
download.rootpath=C:\\NVCLDS\\serve\\

download.cachepath=C:\\NVCLDS\\working\\

tsg.scriptpath=C:\\NVCLDS\\script\\

tsg.exepath="tsgeol8.exe"

msgTimetoLiveDays=1

smtp.enabled=false

smtp.host=
smtp.port=25
smtp.username=
smtp.password=

smtp.useauth=false

smtp.enabledebug=false

jdbc.dbType=sqlserver

jdbc.driverClassName=com.microsoft.sqlserver.jdbc.SQLServerDriver

jdbc.url=
jdbc.username=
jdbc.password=
jdbc.maxTotal=100
jdbc.maxIdle=10
jdbc.minIdle=0
jdbc.maxWaitMillis=10000
jdbc.minEvictableIdleTimeMillis=300000
jdbc.timeBetweenEvictionRunsMillis=300000
jdbc.numTestsPerEvictionRun=20
jdbc.poolPreparedStatements=true
jdbc.maxOpenPreparedStatements=100
jdbc.testOnBorrow=true
jdbc.validationQuery=SELECT CURRENT_TIMESTAMP

spring.activemq.broker-url=vm://embedded

server.port = 8080

server.error.whitelabel.enabled=false

logging.file.name = NVCLDataServicesLogs/NVCLDataServices.log

server.servlet.context-path=/NVCLDataServices

server.forward-headers-strategy=NATIVE

enableAggressiveCacheClearing=true

enableAutoCacheBuilder=false

azureStorageEndPoint=

downloadFileMirror=

minimumDiskspaceinGb=20

writePrepedDSstoAzureBlobStore=true

maxSpacetoUseinGB=100

PrepedDSsAzureBlobStoreContainerName=$web/NVCLPreparedDownloads